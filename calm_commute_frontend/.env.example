# Public environment variables for CalmCommute Frontend
# Copy to .env and adjust as needed. Values here are safe for local demos.

# Optional base URL for a public API used by the app/integrations (leave empty for local-only mode)
NEXT_PUBLIC_API_BASE=""

# Optional backend URL for analytics and auth connect flows, e.g. "http://localhost:4000"
# If empty in production, analytics will not POST and will only log (if not disabled).
NEXT_PUBLIC_BACKEND_URL=""

# Public URL for this frontend (used in redirects), e.g. "http://localhost:3000"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# Optional WebSocket URL for real-time features (not required by default), e.g. "ws://localhost:4000"
NEXT_PUBLIC_WS_URL=""

# Optional override for runtime environment string; falls back to process.env.NODE_ENV
NEXT_PUBLIC_NODE_ENV="development"

# Disable all telemetry/analytics when set to true (true/1/on/yes are treated as true)
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED="false"

# Enable generation of source maps (generally keep false for production)
NEXT_PUBLIC_ENABLE_SOURCE_MAPS="false"

# Port the app advertises via health/config (does not change Next.js server port)
NEXT_PUBLIC_PORT="3000"

# Whether the app should consider that it is behind a proxy
NEXT_PUBLIC_TRUST_PROXY="false"

# Log level: one of "silent","error","warn","info","debug"
NEXT_PUBLIC_LOG_LEVEL="info"

# Healthcheck path (used in /health display and by hosting if applicable)
NEXT_PUBLIC_HEALTHCHECK_PATH="/api/health"

# Feature flags as JSON. Common flags:
#  - mapsTrafficWidget: show traffic widget (and optional map embed)
#  - musicConnect: enable music connect stubs (redirects to backend auth start)
#  - analyticsExperimental: toggle experimental analytics UI
# Example: {"mapsTrafficWidget": true, "musicConnect": false, "analyticsExperimental": false}
NEXT_PUBLIC_FEATURE_FLAGS='{"mapsTrafficWidget": true, "musicConnect": false, "analyticsExperimental": false}'

# Master switch for experiments in config (not required for basic flags)
NEXT_PUBLIC_EXPERIMENTS_ENABLED="false"
