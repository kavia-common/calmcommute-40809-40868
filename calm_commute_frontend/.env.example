# Public environment variables for CalmCommute Next.js frontend
# Copy this file to `.env.local` and adjust values as needed.
# Only NEXT_PUBLIC_* variables are accessible in the browser.

# Base API endpoints (must be absolute URLs)
NEXT_PUBLIC_API_BASE=https://api.example.com
NEXT_PUBLIC_BACKEND_URL=https://backend.example.com
NEXT_PUBLIC_FRONTEND_URL=https://app.example.com
# WebSocket endpoint (must start with ws:// or wss://)
NEXT_PUBLIC_WS_URL=wss://ws.example.com

# Environment metadata
NEXT_PUBLIC_NODE_ENV=development
# Disable Next telemetry in the browser context (default: true)
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=true

# Build/Runtime flags
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=false

# Logging
# one of: silent | error | warn | info | debug
NEXT_PUBLIC_LOG_LEVEL=info

# Healthcheck
NEXT_PUBLIC_HEALTHCHECK_PATH=/api/health

# Feature flags as JSON. Example:
# {"topGradient": true, "analyticsExperimental": true}
NEXT_PUBLIC_FEATURE_FLAGS={"topGradient": false, "analyticsExperimental": false}

# Master toggle to enable reading experiments on client
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false
